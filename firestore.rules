rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid == userId && data.uid.size() >= 3 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120 &&
        data.role is string && data.role in ['donor', 'recipient', 'medical', 'coordinator', 'hospital', 'admin'] &&
        data.status is string && data.status in ['ACTIVE', 'SUSPENDED'] &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidDonorRecord(data) {
      return data.keys().hasAll(['ownerUid', 'anonymizedCode', 'bloodGroup', 'donationType', 'isWithdrawn', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'anonymizedCode', 'bloodGroup', 'donationType', 'isWithdrawn', 'withdrawalReason', 'createdAt', 'updatedAt']) &&
        data.ownerUid is string && data.ownerUid.size() >= 3 && data.ownerUid.size() <= 128 &&
        data.anonymizedCode is string && data.anonymizedCode.size() >= 4 && data.anonymizedCode.size() <= 64 &&
        data.bloodGroup is string && data.bloodGroup in ['O+', 'O-', 'A+', 'A-', 'B+', 'B-', 'AB+', 'AB-'] &&
        data.donationType is string && data.donationType in ['DECEASED', 'LIVING'] &&
        data.isWithdrawn is bool &&
        (!('withdrawalReason' in data) || (data.withdrawalReason is string && data.withdrawalReason.size() <= 500)) &&
        data.createdAt is timestamp &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidNotificationItem(data) {
      return data.keys().hasAll(['ownerUid', 'title', 'message', 'category', 'isRead', 'createdAt']) &&
        data.keys().hasOnly(['ownerUid', 'title', 'message', 'category', 'isRead', 'createdAt']) &&
        data.ownerUid is string && data.ownerUid.size() >= 3 && data.ownerUid.size() <= 128 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 2 && data.message.size() <= 500 &&
        data.category is string && data.category in ['APPROVAL', 'CONSENT', 'LOGISTICS', 'DATA_QUALITY', 'ADMIN', 'RECOVERY'] &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isOwner(adminUid);
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == request.auth.uid &&
        incoming().role == 'donor' &&
        incoming().status == 'ACTIVE' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isSignedIn() && isValidUserProfile(incoming(), userId) && (
        (isAdmin() &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt) ||
        (isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
      );
      allow delete: if false;
    }

    match /donors/{donorId} {
      allow get: if isValidId(donorId) && (isOwner(existing().ownerUid) || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(donorId) && isSignedIn() &&
        isValidDonorRecord(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isValidId(donorId) && isSignedIn() && isValidDonorRecord(incoming()) && (
        (isAdmin() &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt) ||
        (isOwner(existing().ownerUid) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isWithdrawn', 'withdrawalReason', 'updatedAt']))
      );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isOwner(existing().ownerUid) || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(notificationId) && isSignedIn() &&
        isValidNotificationItem(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isValidId(notificationId) && isSignedIn() && isValidNotificationItem(incoming()) && (
        (isAdmin() &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt) ||
        (isOwner(existing().ownerUid) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead']))
      );
      allow delete: if false;
    }
  }
}
