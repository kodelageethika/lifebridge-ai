# ==============================================================================
# LifeBridge AI — Environment Configuration Template
# Copy to .env for local overrides. Never commit real credentials or secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime & Security
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"

# Hosted URL of the applet (injected automatically in cloud preview environments)
APP_URL="http://localhost:3000"

# Allowed browser origins for CORS + CSRF origin enforcement (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,https://kodelageethika.github.io"

# Production Secrets (Required >= 24 chars when NODE_ENV="production"; omit/replace defaults)
SESSION_SECRET=
AUDIT_HMAC_SECRET=

# ------------------------------------------------------------------------------
# 2. Gemini AI Integration (Server-Side Only — NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=3
AI_RETRY_BASE_MS=500

# ------------------------------------------------------------------------------
# 3. Database Configuration (json | postgres)
# ------------------------------------------------------------------------------
# Use "json" for immediate local development or "postgres" for Prisma + PostgreSQL
DB_DRIVER="json"
DB_PATH="./server/data/lifebridge-db.json"

# Managed PostgreSQL connection URL (required when DB_DRIVER="postgres" and for Prisma CLI)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lifebridge_ai?schema=public"
DB_POOL_MAX=10
AUTO_SEED_EMPTY_DB="false"

# ------------------------------------------------------------------------------
# 4. Async SMTP Email Notification Service (nodemailer)
# ------------------------------------------------------------------------------
# Gmail SMTP example: SMTP_HOST="smtp.gmail.com", SMTP_PORT=465, SMTP_SECURE="true"
# (Use a dedicated Google App Password in SMTP_PASSWORD; never commit secrets.)
EMAIL_NOTIFICATIONS_ENABLED="false"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="noreply@lifebridge-demo.local"
SMTP_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. Frontend Build-Time Public Configuration (Safe to expose to browser)
# ------------------------------------------------------------------------------
# Leave empty for single-host Express + Vite serving; set backend origin for GitHub Pages split hosting
VITE_API_BASE_URL=""
# Set to "/lifebridge-ai/" when publishing to GitHub Pages project subpath
VITE_BASE_PATH="/"
